data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
logs/*
!logs/.gitkeep
__pycache__/
*.pyc
.DS_Store
*.log
# BEAST outputs are large; archive them separately (Zenodo), don't commit
*.trees
*.state
.ipynb_checkpoints/
.ipynb_checkpoints/
beast/**/*.trees
!beast/**/*.log

*.bak.json

*.prescrub

# Build outputs (wildphylo convention). A build is reproducible from its config
# and accession list, so artefacts are not tracked; the audit trail is.
builds/*/*/raw/*
builds/*/*/interim/*
builds/*/*/aligned/*
builds/*/*/tree/*
builds/*/*/subsampled/*
builds/*/*/beast/*
builds/*/*/drt/*
builds/*/*/logs/*
!builds/*/*/provenance.json
!builds/*/*/checks.json
!builds/*/*/temporal/*
!builds/*/*/qc/*.tsv
!builds/*/*/raw/*.acc
!builds/*/*/build_comparison.md
!builds/*/*/build_comparison.json
builds/*/*/clades/*/*
!builds/*/*/clades/*/*.json
!builds/*/*/clades/*/*.md
!builds/*/*/clades/*/*.tsv
.snakemake/
